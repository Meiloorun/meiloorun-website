{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meiloorun-website",
  "workers_dev": true,
  // After registering meiloorun.gg, add it as a Worker Custom Domain.
  // Keep workers.dev available for testing; no domain is required now.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "TRACKER_CACHE", "class_name": "TrackerCache" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrackerCache"] }]
}
