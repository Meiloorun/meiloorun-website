---
export const prerender = false;
import { setting } from '../../lib/trackerRuntime.mjs';
import GamesPage from '../../components/media/GamesPage';
import PageLayout from '../../layouts/PageLayout.astro';
import { loadMainGame, loadLibraryArtwork } from '../../lib/igdb';
import { loadGameLibrary } from '../../lib/gameLibrary';
import { readMainGameId, siteSettingsDatabase } from '../../lib/siteSettings';
const library = await loadGameLibrary();
const [mainGame, artwork] = await Promise.all([
  Promise.resolve().then(() => readMainGameId(siteSettingsDatabase())).then(loadMainGame).catch(() => {
    console.warn('Main game setting unavailable. Check database configuration and migrations.');
    return { state: 'unavailable' } as const;
  }),
  loadLibraryArtwork(library.entries.flatMap(game => game.igdbId ? [game.igdbId] : [])),
]);

---

<PageLayout title="Games | Meiloorun" description="Meiloorun's games: favourites, trackers, and recent activity.">
  <GamesPage profileUrl={setting('INFINITE_BACKLOG_PROFILE_URL')} mainGame={mainGame} library={library} artwork={artwork} streamParents={[Astro.url.hostname]} />
</PageLayout>

