---
export const prerender = false;
import { setting } from '../../lib/trackerRuntime.mjs';
import ComicsPage from '../../components/media/ComicsPage';
import PageLayout from '../../layouts/PageLayout.astro';
import ComicReadingChecklist from '../../components/media/ComicReadingChecklist';
import { readingDatabase, readingSummary } from '../../lib/comicReading';

const summary = await readingSummary(readingDatabase()).catch(() => undefined);

---

<PageLayout title="Comics | Meiloorun" description="Meiloorun's comics: favourites, trackers, and recent activity.">
  <ComicsPage profileUrl={setting('BATCAVE_PROFILE_URL')} embedUrl={setting('BATCAVE_EMBED_URL')}>
    <ComicReadingChecklist slot="readingTracker" client:load initialSummary={summary} canEdit={!!Astro.locals.adminSession} />
  </ComicsPage>
</PageLayout>

