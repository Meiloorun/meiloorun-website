---
export const prerender = false;
import { setting } from '../../lib/trackerRuntime.mjs';
import MoviesPage from '../../components/media/MoviesPage';
import PageLayout from '../../layouts/PageLayout.astro';
import { loadSimkl } from '../../lib/mediaTrackers';
const feed = await loadSimkl();
---

<PageLayout title="Movies | Meiloorun" description="Meiloorun's movies: favourites, trackers, and recent activity.">
  <MoviesPage profileUrl={setting('SIMKL_PROFILE_URL')} feed={feed.movies} />
</PageLayout>

